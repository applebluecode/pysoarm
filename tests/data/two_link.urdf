<?xml version="1.0"?>
<!-- Minimal planar 2-link arm used by the kinematics tests: two revolute joints about z,
     link lengths 1.0 m and 0.5 m, end-effector frame "tool0". -->
<robot name="two_link">
  <link name="base_link"/>

  <joint name="j1" type="revolute">
    <parent link="base_link"/>
    <child link="l1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1"/>
  </joint>
  <link name="l1"/>

  <joint name="j2" type="revolute">
    <parent link="l1"/>
    <child link="l2"/>
    <origin xyz="1.0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1"/>
  </joint>
  <link name="l2"/>

  <joint name="tool_fixed" type="fixed">
    <parent link="l2"/>
    <child link="tool0"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
  </joint>
  <link name="tool0"/>
</robot>
